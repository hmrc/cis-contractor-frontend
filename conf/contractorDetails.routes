# Contractor Details - Multitab
GET   /contractor-details/manage/:flowId     controllers.contractordetails.ManageContractorDetailsController.onPageLoadWithId(flowId: java.util.UUID, target: Option[String] ?= None)

GET   /contractor-details/introduction/start/:cisId  controllers.contractordetails.ContractorDetailsController.onPageLoadStart(cisId: String)
POST  /contractor-details/introduction/start/:cisId  controllers.contractordetails.ContractorDetailsController.onSubmitStart(cisId: String)

GET   /contractor-details/introduction/:flowId   controllers.contractordetails.ContractorDetailsController.onPageLoadWithId(flowId: java.util.UUID)
POST  /contractor-details/introduction/:flowId    controllers.contractordetails.ContractorDetailsController.onSubmitWithId(flowId: java.util.UUID)

GET   /contractor-details/enter-contractor-scheme-name/:flowId     controllers.contractordetails.SchemeNameController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
POST  /contractor-details/enter-contractor-scheme-name/:flowId     controllers.contractordetails.SchemeNameController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
GET   /contractor-details/change-contractor-scheme-name/:flowId     controllers.contractordetails.SchemeNameController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = CheckMode)
POST  /contractor-details/change-contractor-scheme-name/:flowId    controllers.contractordetails.SchemeNameController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = CheckMode)

GET   /contractor-details/enter-contractor-email-address/:flowId    controllers.contractordetails.EnterContractorEmailAddressController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
POST  /contractor-details/enter-contractor-email-address/:flowId    controllers.contractordetails.EnterContractorEmailAddressController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
GET   /contractor-details/change-contractor-email-address/:flowId     controllers.contractordetails.EnterContractorEmailAddressController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = CheckMode)
POST  /contractor-details/change-contractor-email-address/:flowId     controllers.contractordetails.EnterContractorEmailAddressController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = CheckMode)

GET   /contractor-details/enter-contractor-utr/:flowId    controllers.contractordetails.ContractorUtrController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
POST  /contractor-details/enter-contractor-utr/:flowId   controllers.contractordetails.ContractorUtrController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
GET   /contractor-details/change-contractor-utr/:flowId    controllers.contractordetails.ContractorUtrController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = CheckMode)
POST  /contractor-details/change-contractor-utr/:flowId    controllers.contractordetails.ContractorUtrController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = CheckMode)

GET   /contractor-details/add-contractor-email-address/:flowId    controllers.contractordetails.AddEmailAddressYesNoController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
POST  /contractor-details/add-contractor-email-address/:flowId    controllers.contractordetails.AddEmailAddressYesNoController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
GET   /contractor-details/change-add-contractor-email-address/:flowId      controllers.contractordetails.AddEmailAddressYesNoController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = CheckMode)
POST  /contractor-details/change-add-contractor-email-address/:flowId     controllers.contractordetails.AddEmailAddressYesNoController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = CheckMode)

GET   /contractor-details/add-contractor-scheme-name/:flowId    controllers.contractordetails.AddSchemeNameYesNoController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
POST  /contractor-details/add-contractor-scheme-name/:flowId    controllers.contractordetails.AddSchemeNameYesNoController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = NormalMode)
GET   /contractor-details/change-add-contractor-scheme-name/:flowId      controllers.contractordetails.AddSchemeNameYesNoController.onPageLoadWithId(flowId: java.util.UUID, mode: Mode = CheckMode)
POST  /contractor-details/change-add-contractor-scheme-name/:flowId      controllers.contractordetails.AddSchemeNameYesNoController.onSubmitWithId(flowId: java.util.UUID, mode: Mode = CheckMode)

GET   /contractor-details/remove-contractor-detail/:contractorDetail/:flowId     controllers.contractordetails.RemoveDetailYesNoController.onPageLoadWithId(flowId: java.util.UUID, contractorDetail: String)
POST  /contractor-details/remove-contractor-detail/:contractorDetail/:flowId     controllers.contractordetails.RemoveDetailYesNoController.onSubmitWithId(flowId: java.util.UUID, contractorDetail: String)

GET   /contractor-details/contractor-details-added/:flowId             controllers.contractordetails.ContractorDetailsCheckAnswersController.onPageLoadWithId(flowId: java.util.UUID, target: Option[String] ?= None)
POST  /contractor-details/contractor-details-added/:flowId             controllers.contractordetails.ContractorDetailsCheckAnswersController.onSubmitWithId(flowId: java.util.UUID, target: Option[String] ?= None)

GET   /contractor-details/contractor-details-updated/:flowId    controllers.contractordetails.ContractorDetailsUpdatedController.onPageLoadWithId(flowId: java.util.UUID)


